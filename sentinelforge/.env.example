# ─────────────────────────────────────────────────────────────────
# SentinelForge Environment Variables
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── General ──────────────────────────────────────────────────────
SF_LOG_LEVEL=INFO
SF_OUTPUT_DIR=output
SF_MAX_THREADS=10
SF_TIMEOUT=30
SF_PROFILE=normal

# ── Network ──────────────────────────────────────────────────────
# SF_PROXY=http://127.0.0.1:8080

# ── Integrations ─────────────────────────────────────────────────
# Shodan (https://account.shodan.io/)
# SF_SHODAN_API_KEY=your_shodan_api_key_here

# Neo4j Attack Graph Database
# SF_NEO4J_URI=bolt://localhost:7687
# SF_NEO4J_USER=neo4j
# SF_NEO4J_PASSWORD=your_neo4j_password_here
